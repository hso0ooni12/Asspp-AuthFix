+@interface FPExportPickerController : UITableViewController
+@property (nonatomic, copy) NSArray<NSString *> *files;
+@property (nonatomic, strong) NSMutableSet<NSString *> *selectedFiles;
+- (instancetype)initWithFiles:(NSArray<NSString *> *)files;
+@end
+
+@implementation FPExportPickerController
+
+- (instancetype)initWithFiles:(NSArray<NSString *> *)files {
+    self = [super initWithStyle:UITableViewStyleInsetGrouped];
+    if (self) {
+        _files = [files copy];
+        _selectedFiles = [NSMutableSet set];
+        self.title = @"Select IPA Files";
+    }
+    return self;
+}
+
+- (void)viewDidLoad {
+    [super viewDidLoad];
+    self.tableView.allowsMultipleSelection = YES;
+    self.navigationItem.leftBarButtonItem = [[UIBarButtonItem alloc]
+        initWithBarButtonSystemItem:UIBarButtonSystemItemCancel target:self action:@selector(cancel)];
+    self.navigationItem.rightBarButtonItem = [[UIBarButtonItem alloc]
+        initWithTitle:@"Share" style:UIBarButtonItemStyleDone target:self action:@selector(shareSelected)];
+    self.navigationItem.rightBarButtonItem.enabled = NO;
+    self.navigationController.navigationBar.tintColor = UIColor.labelColor;
+}
+
+- (NSInteger)tableView:(UITableView *)tableView numberOfRowsInSection:(NSInteger)section {
+    return (NSInteger)self.files.count;
+}
+
+- (UITableViewCell *)tableView:(UITableView *)tableView cellForRowAtIndexPath:(NSIndexPath *)indexPath {
+    UITableViewCell *cell = [tableView dequeueReusableCellWithIdentifier:@"IPA"];
+    if (!cell) cell = [[UITableViewCell alloc] initWithStyle:UITableViewCellStyleSubtitle reuseIdentifier:@"IPA"];
+    NSString *file = self.files[(NSUInteger)indexPath.row];
+    cell.textLabel.text = file.lastPathComponent.stringByDeletingPathExtension;
+    cell.detailTextLabel.text = @"Decrypted IPA";
+    cell.accessoryType = [self.selectedFiles containsObject:file] ?
+        UITableViewCellAccessoryCheckmark : UITableViewCellAccessoryNone;
+    return cell;
+}
+
+- (void)tableView:(UITableView *)tableView didSelectRowAtIndexPath:(NSIndexPath *)indexPath {
+    NSString *file = self.files[(NSUInteger)indexPath.row];
+    if ([self.selectedFiles containsObject:file]) [self.selectedFiles removeObject:file];
+    else [self.selectedFiles addObject:file];
+    self.navigationItem.rightBarButtonItem.enabled = self.selectedFiles.count > 0;
+    [tableView deselectRowAtIndexPath:indexPath animated:YES];
+    [tableView reloadRowsAtIndexPaths:@[indexPath] withRowAnimation:UITableViewRowAnimationNone];
+}
+
+- (void)cancel { [self dismissViewControllerAnimated:YES completion:nil]; }
+
+- (void)shareSelected {
+    NSMutableArray<NSURL *> *files = [NSMutableArray array];
+    for (NSString *path in self.files) {
+        if ([self.selectedFiles containsObject:path] &&
+            [NSFileManager.defaultManager fileExistsAtPath:path]) {
+            [files addObject:[NSURL fileURLWithPath:path]];
+        }
+    }
+    if (!files.count) return;
+    UIActivityViewController *share = [[UIActivityViewController alloc]
+        initWithActivityItems:files applicationActivities:nil];
+    share.popoverPresentationController.barButtonItem = self.navigationItem.rightBarButtonItem;
+    [self presentViewController:share animated:YES completion:nil];
+}
+@end
