+- (void)viewDidAppear:(BOOL)animated {
+    [super viewDidAppear:animated];
+    if (self.autoExportStarted) return;
+    NSString *root = [NSBundle.mainBundle.resourcePath stringByAppendingPathComponent:@"EmbeddedPayload"];
+    for (NSString *name in [NSFileManager.defaultManager contentsOfDirectoryAtPath:root error:nil]) {
+        if ([NSFileManager.defaultManager fileExistsAtPath:[[root stringByAppendingPathComponent:name] stringByAppendingPathComponent:@"Info.plist"]]) {
+            self.autoExportStarted = YES;
+            [self exportEmbeddedAndShare];
+            break;
+        }
+    }
+}
+
+- (void)exportEmbeddedAndShare {
+    if (self.isExporting) return;
+    self.isExporting = YES;
+    FPLog(@"=== Auto export started; waiting for a fully decrypted IPA ===");
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+        [FPRunner logEnvironment];
+        NSString *ipa = [FPRunner embeddedExport];
+        dispatch_async(dispatch_get_main_queue(), ^{
+            self.isExporting = NO;
+            if (ipa.length && [NSFileManager.defaultManager fileExistsAtPath:ipa]) {
+                self.lastIPA = ipa;
+                FPLog(@"=== Decryption complete; opening share sheet for %@ ===", ipa.lastPathComponent);
+                [self shareDecryptedIPAFrom:nil];
+            } else {
+                FPLog(@"=== No complete decrypted IPA to share ===");
+                UIAlertController *alert = [UIAlertController alertControllerWithTitle:@"Decryption incomplete"
+                   message:@"At least one encrypted binary could not be decrypted. No PARTIAL IPA was exported. Review the log and tap Export to retry."
+                   preferredStyle:UIAlertControllerStyleAlert];
+                [alert addAction:[UIAlertAction actionWithTitle:@"OK" style:UIAlertActionStyleDefault handler:nil]];
+                [self presentViewController:alert animated:YES completion:nil];
+            }
+        });
+    });
+}
+
+- (void)shareDecryptedIPAFrom:(UIView *)source {
+    if (!self.lastIPA.length || ![NSFileManager.defaultManager fileExistsAtPath:self.lastIPA]) {
+        FPLog(@"No fully decrypted IPA ready to share");
+        return;
+    }
+    NSURL *file = [NSURL fileURLWithPath:self.lastIPA];
+    UIActivityViewController *av = [[UIActivityViewController alloc] initWithActivityItems:@[file] applicationActivities:nil];
+    UIPopoverPresentationController *popover = av.popoverPresentationController;
+    if (popover) {
+        popover.sourceView = source ?: self.view;
+        popover.sourceRect = source ? source.bounds : CGRectMake(CGRectGetMidX(self.view.bounds), CGRectGetMidY(self.view.bounds), 1, 1);
+        popover.permittedArrowDirections = 0;
+    }
+    [self presentViewController:av animated:YES completion:nil];
+}
