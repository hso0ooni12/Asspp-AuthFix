+- (void)shareDecryptedIPAFrom:(UIView *)source {
+    if (!self.lastIPA.length || ![NSFileManager.defaultManager fileExistsAtPath:self.lastIPA]) {
+        FPLog(@"No fully decrypted IPA ready to share");
+        return;
+    }
+    NSURL *file = [NSURL fileURLWithPath:self.lastIPA];
+    UIActivityViewController *av = [[UIActivityViewController alloc] initWithActivityItems:@[file] applicationActivities:nil];
+    UIPopoverPresentationController *popover = av.popoverPresentationController;
+    if (popover) {
+        popover.sourceView = source ?: self.view;
+        popover.sourceRect = source ? source.bounds : CGRectMake(CGRectGetMidX(self.view.bounds), CGRectGetMidY(self.view.bounds), 1, 1);
+        popover.permittedArrowDirections = 0;
+    }
+    [self presentViewController:av animated:YES completion:nil];
+}
